{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "appzed-invoice-chaser",
  "main": "worker.js",
  "compatibility_date": "2026-10-14",
  "ai": {
    "binding": "AI"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "appzed-invoice-chaser-meta"
    }
  ],
  "triggers": {
    "crons": ["0 9 * * *"]
  }
}
